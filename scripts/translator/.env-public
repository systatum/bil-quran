FE_API_KEY_DEFAULT=tl-default_token # Can override with .env or env var
FE_API_KEY_LOCAL=tl-default_token
#FE_API_KEY_REMOTE=tl-some_secret_token

BE_API_KEY=tl-default_token
BE_SETTING_SYS_PATH=.
BE_SETTING_PYTHON_PATH=mount.setting
BE_MOUNT_ROOT=./backend/mount

#PX_RUNPOD_MANAGEMENT_KEY=rpa_some-secret-key
#PX_API_KEY_REMOTE=tl-some_secret_token # Should probably be the same as FE_API_KEY_REMOTE
PX_WORKDIR=./proxy
PX_CADDY_PORT=8049
PX_MAX_POD_LIFETIME_SECONDS=18000  # 5 hours
PX_MAX_POD_INACTIVITY_SECONDS=1800  # 30 minutes

HF_HOME=./backend/mount/hf_cache