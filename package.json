    "deploy": "gh-pages -d build",
    "db:generate": "drizzle-kit generate",
    "prepare-assets": "pnpm run split-chapter && pnpm run fingerprint",
    "fingerprint": "node scripts/fingerprinter.js",
    "split-chapter": "node scripts/split-chapter.js"
  },
  "dependencies": {
    "@remixicon/react": "^4.9.0",
    "@systatum/coneto": "file:./../coneto",
    "@tanstack/react-router": "^1.169.2",
    "@tanstack/react-virtual": "^3.13.24",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^13.5.0",
    "@types/jest": "^27.5.2",
    "@types/node": "^16.18.126",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "drizzle-orm": "^0.45.2",
    "idb-keyval": "^6.2.4",
    "ios-haptics": "^0.1.5",
    "nanoid": "^5.1.11",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-hot-toast": "^2.6.0",
    "react-intl": "^10.1.9",
    "react-scripts": "5.0.1",
    "rss": "^1.2.2",
    "sql.js": "^1.14.1",
    "styled-components": "^6.4.1",
    "typescript": "^4.9.5",
    "web-vitals": "^2.1.4",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@craco/craco": "^7.1.0",
    "@types/pg": "^8.20.0",
    "@types/rss": "^0.0.32",
    "@types/sql.js": "^1.4.11",
    "drizzle-kit": "^0.31.10",
    "gh-pages": "^6.3.0",
    "oxfmt": "^0.48.0"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
