{
  "name": "bil-quran",
  "version": "0.1.0",
  "private": true,
  "homepage": "https://bil-quran.com",
  "scripts": {
    "prestart": "pnpm run split-chapter",
    "start": "craco start",
    "build": "craco build",
    "test": "craco test",
