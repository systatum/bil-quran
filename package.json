{
  "name": "bil-quran",
  "version": "1.1.0",
  "private": true,
  "homepage": "https://bil-quran.com",
  "scripts": {
    "prestart": "pnpm run split-chapter",
    "start": "craco start",
    "start:android": "cap run android",
    "start:ios": "cap run ios",
    "build:mobile:android": "pnpm run build && pnpm run predeploy && cap sync android",
    "build:android:apk": "pnpm build:mobile:android && cd android && ./gradlew assembleRelease",
    "build:android:aab": "pnpm build:mobile:android && cd android && ./gradlew bundleRelease",
    "build": "craco build && node scripts/inject-build-info.js",
    "test": "pnpm run test:unit && pnpm run test:e2e",
    "test:unit": "craco test --watchAll=false --passWithNoTests",
    "test:e2e": "playwright test",
    "predeploy": "pnpm run prepare-assets && pnpm run build && pnpm run generate-rss && node scripts/pre-deploy.js",
    "generate-rss": "tsx scripts/generate-rss.ts",
    "deploy": "gh-pages -d build",
    "deploy:staging": "",
    "db:generate": "drizzle-kit generate",
    "prepare-assets": "pnpm run split-chapter && pnpm run fingerprint",
    "fingerprint": "node scripts/fingerprinter.js",
    "split-chapter": "node scripts/split-chapter.js"
  },
  "dependencies": {
    "@capacitor/android": "^8.3.4",
    "@capacitor/cli": "^8.3.4",
    "@capacitor/core": "^8.3.4",
    "@capacitor/haptics": "^8.0.2",
    "@electric-sql/pglite": "^0.4.5",
    "@posthog/react": "^1.10.3",
    "@remixicon/react": "^4.9.0",
    "@systatum/coneto": "^3.2.0",
    "@tanstack/react-router": "^1.169.2",
    "@tanstack/react-virtual": "^3.13.24",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^13.5.0",
    "@types/jest": "^27.5.2",
    "@types/node": "^16.18.126",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "drizzle-orm": "^0.45.2",
    "idb-keyval": "^6.2.4",
    "marked": "^18.0.5",
    "nanoid": "^5.1.11",
    "posthog-js": "^1.408.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-intl": "^10.1.9",
    "react-scripts": "5.0.1",
    "rss": "^1.2.2",
    "sql.js": "^1.14.1",
    "styled-components": "^6.4.1",
    "typescript": "^4.9.5",
    "web-vitals": "^2.1.4",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@craco/craco": "^7.1.0",
    "@playwright/test": "^1.61.0",
    "@posthog/types": "^1.399.0",
    "@types/pg": "^8.20.0",
    "@types/rss": "^0.0.32",
    "@types/sql.js": "^1.4.11",
    "drizzle-kit": "^0.31.10",
    "gh-pages": "^6.3.0",
    "oxfmt": "^0.48.0",
    "playwright": "^1.61.0",
    "playwright-core": "^1.61.0"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  }
}
